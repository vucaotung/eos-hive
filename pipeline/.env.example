# Sao chép thành pipeline/.env (đã nằm trong .gitignore) hoặc đặt DEO_ENV_FILE trỏ tới một tệp khác. KHÔNG commit giá trị thật.

# Thư mục làm việc: ngắn để tránh đường dẫn Windows > 260 ký tự. Mặc định: C:\eos-work (Windows), ~/work (Linux)
WORK_DIR=

# Chương trình ngoài (để trống = tự dò đường dẫn thông dụng)
SOFFICE_BIN=
PANDOC_BIN=
TESSERACT_CMD=
# Thư mục chứa vie.traineddata bản best (kèm eng, osd và thư mục configs/). Trống = dữ liệu mặc định của Tesseract
TESSDATA_DIR=
OCR_LANG=vie
# OCR: dpi render trang scan (trang khổ lớn bị giảm để cạnh dài ≤ OCR_MAX_SIDE_PX); trang dưới ngưỡng tin cậy vào mục "Cần soát"
OCR_DPI=300
OCR_MAX_SIDE_PX=4500
OCR_REVIEW_BELOW=0.80
# Ảnh: cạnh dài tối đa, chất lượng JPEG, kích thước tối đa (MB; MCP từ chối ảnh > 10 MB)
IMAGE_MAX_SIDE=2000
IMAGE_QUALITY=85
IMAGE_MAX_MB=10

# Tệp nguồn lớn hơn mức này (MB) chỉ được liệt kê, không tải
MAX_SOURCE_MB=300
# Trang PDF có ít hơn ngần này ký tự = trang scan
PDF_TEXT_MIN_CHARS=30

# Tải/đẩy Drive qua Drive API (chỉ cần khi chạy `fetch <id>` và `push`; không cần cho --source-dir)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
