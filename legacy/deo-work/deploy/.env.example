# Sao chép thành .env (chmod 600). install.sh tự sinh các giá trị *_PW và JWT_SECRET nếu để trống.
AUTHENTICATOR_PW=
AUTH_SVC_PW=
JWT_SECRET=
# OAuth client loại "Web application" trong Google Cloud, origin https://work.enterpriseos.bond
GOOGLE_CLIENT_ID=
# Tài khoản Workspace riêng của agent; nhân viên chia sẻ thư mục Drive cho địa chỉ này
AGENT_EMAIL=hermes-bot@enterpriseos.bond
# IP Tailscale của VPS 169 để Hermes gọi PostgREST; để trống thì chỉ nghe 127.0.0.1
TAILSCALE_IP=100.70.174.54
