# /opt/apps/enterprise-os/mcp/.env  (chmod 600, không đưa vào git, không dán vào chat)
DATABASE_URL=postgres://eos_mcp:<mật-khẩu>@127.0.0.1:5432/eos
PORT=8790
MCP_RATE_PER_MIN=120
# tài khoản agent Workspace (cùng bộ với drive_sync.py)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Kho tri thức WeKnora cho eos_kb_ingest (khóa chỉ ở máy chủ MCP; Hermes không thấy). Mẫu cấu hình KB mới sao chép từ WEKNORA_TEMPLATE_KB.
WEKNORA_BASE_URL=https://kb.enterpriseos.bond/api/v1
WEKNORA_API_KEY=
#WEKNORA_TEMPLATE_KB=kdc-thanh-lap
