# /opt/apps/enterprise-os/mcp/.env  (chmod 600, không đưa vào git, không dán vào chat)
DATABASE_URL=postgres://eos_mcp:<mật-khẩu>@127.0.0.1:5432/eos
PORT=8790
MCP_RATE_PER_MIN=120
# tài khoản agent Workspace (cùng bộ với drive_sync.py)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Kho tri thức WeKnora cho eos_kb_ingest (khóa chỉ ở máy chủ MCP; Hermes không thấy). Mẫu cấu hình KB mới sao chép từ WEKNORA_TEMPLATE_KB.
WEKNORA_BASE_URL=https://kb.enterpriseos.bond/api/v1
WEKNORA_API_KEY=
#WEKNORA_TEMPLATE_KB=kdc-thanh-lap
# Giới hạn mã sai (docs/16, docs/17): khóa theo (IP, 8 ký tự đầu của mã gửi lên) 20 lần/5 phút; tổng theo IP 200 lần/5 phút.
#MCP_AUTHFAIL_MAX=20
#MCP_AUTHFAIL_IP_MAX=200
#MCP_AUTHFAIL_WINDOW_MS=300000
# IP được MIỄN ngưỡng tổng theo IP (vẫn chịu ngưỡng theo cặp). Mọi bot trên vps173 (Mai, ks-kinh-te-xd, cron bản tin, cầu nối) gọi từ cùng một IP:
# một mã hết hạn thử lại liên tục không được khóa cả nhóm. Danh sách phân tách bằng dấu phẩy; mặc định trống.
MCP_AUTHFAIL_ALLOW=173.249.51.69
